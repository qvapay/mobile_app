{
	"name": "QvaPay",
	"version": "3.5.1",
	"private": true,
	"scripts": {
		"android": "react-native run-android --main-activity .MainActivity",
		"ios:build": "cd ios && xcodebuild -workspace QvaPay.xcworkspace -scheme QvaPay -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 16' build",
		"ios": "react-native run-ios",
		"ios:device": "bash scripts/run-ios-device.sh",
		"pods": "cd ios && pod install",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"i18n:check": "node scripts/check-i18n.js",
		"i18n:usage": "node scripts/check-i18n-usage.js",
		"start": "react-native start",
		"test": "jest",
		"android:bundle": "cd android && ./gradlew bundleRelease",
		"android:apk": "cd android && ./gradlew assembleRelease",
		"android:release": "cd android && ./gradlew bundleRelease && ./gradlew assembleRelease",
		"android:apk:release": "bash scripts/release-android.sh",
		"android:publish": "cd android && ./gradlew publishBundle",
		"android:publish:internal": "cd android && ./gradlew publishBundle --track internal --release-status completed",
		"android:publish:production": "cd android && ./gradlew publishBundle --track production --release-status draft",
		"version:sync": "node scripts/sync-version.js",
		"preios": "node scripts/sync-version.js",
		"preios:device": "node scripts/sync-version.js",
		"preios:build": "node scripts/sync-version.js",
		"preandroid": "node scripts/sync-version.js",
		"doctor": "npx react-doctor@latest",
		"postinstall": "patch-package --error-on-fail",
		"e2e:wallet": "maestro test .maestro --test-output-dir .maestro/output"
	},
	"codegenConfig": {
		"name": "QvaPaySpecs",
		"type": "components",
		"jsSrcsDir": "specs",
		"android": {
			"javaPackageName": "com.qvapay.specs"
		},
		"ios": {
			"componentProvider": {
				"QPSecureView": "QPSecureView"
			}
		}
	},
	"dependencies": {
		"@adrianso/react-native-device-brightness": "^1.2.7",
